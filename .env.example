# Copy to .env and fill in. Never commit the real .env.

FLASK_ENV=development
SECRET_KEY=change-me

# Runtime application role — must NOT be a superuser or table owner,
# and must have NOSUPERUSER/NOBYPASSRLS (see scripts/bootstrap_db_roles.sql).
# RLS is silently bypassed if this points at the owner/superuser role.
DATABASE_URL=postgresql+psycopg://solgrid_app:solgrid_app_password@localhost:5432/solgrid_tea

# Owner/migration role — used only by `alembic upgrade head` and the
# bootstrap script, never by the running app.
MIGRATIONS_DATABASE_URL=postgresql+psycopg://solgrid_owner:solgrid_owner_password@localhost:5432/solgrid_tea

JWT_SECRET_KEY=change-me-too
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

CORS_ORIGINS=http://localhost:5173

# Africa's Talking (Tier-4 SMS/USSD ingestion — wired in a later build step)
AT_USERNAME=
AT_API_KEY=
AT_INBOUND_SHORTCODE=
