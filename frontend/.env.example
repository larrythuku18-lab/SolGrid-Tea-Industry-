VITE_API_BASE_URL=http://localhost:5000

# Optional: shows a clickable "Demo credentials" hint on the login screen
# that autofills these on click. Leave both unset for a real deployment —
# whatever's set here is baked into the built JS bundle and visible to
# anyone who opens the login page, by design (it's meant to be shown).
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
